{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPOBRAS",
  "version": "0.1.0",
  "identifier": "ar.cpobras.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CPOBRAS — Gestión de obras",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
