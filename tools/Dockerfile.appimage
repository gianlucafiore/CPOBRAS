# Build against glibc 2.35 for Linux Mint 21/22 and Ubuntu 22.04/24.04.
FROM node:24.22.1-bookworm-slim AS node
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then \
      export APT_CA="-o Acquire::https::CaInfo=/run/secrets/proxy_ca"; \
    fi; \
    apt-get ${APT_CA:-} update && \
    apt-get ${APT_CA:-} install -y --no-install-recommends \
      build-essential pkg-config libwebkit2gtk-4.1-dev libxdo-dev libssl-dev \
      librsvg2-dev libayatana-appindicator3-dev curl wget file patchelf \
      squashfs-tools desktop-file-utils libfuse2 fuse ca-certificates \
      xvfb xauth dbus-x11 x11-utils scrot xdg-utils && \
    rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/ /usr/local/
RUN groupadd --gid 1000 cpobras && useradd --uid 1000 --gid 1000 --create-home cpobras
WORKDIR /workspace/CPOBRAS
