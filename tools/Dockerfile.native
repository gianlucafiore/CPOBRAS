FROM debian:trixie-slim
RUN --mount=type=secret,id=proxy_ca,required=true \
    apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca update && \
    apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca install -y --no-install-recommends \
      build-essential pkg-config libwebkit2gtk-4.1-dev libxdo-dev libssl-dev \
      librsvg2-dev libayatana-appindicator3-dev xvfb xauth dbus-x11 ca-certificates x11-utils scrot && \
    rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 1000 cpobras && useradd --uid 1000 --gid 1000 --create-home cpobras
WORKDIR /workspace/CPOBRAS
